    Instruction("I3", "R7", ["R1", "R4"]),
    Instruction("I4", "R8", ["R9", "R10"]),
    Instruction("I5", "R11", ["R7", "R8"]),
    Instruction("I6", "R12", ["R13", "R14"]),
]

def detect_hazards(inst1, inst2):
    """
    Mendeteksi dependensi / hazard antara dua instruksi (inst1 dijalankan sebelum inst2):
    - RAW (Read After Write / True Dependency): inst2 membaca register yang ditulis oleh inst1.
    - WAR (Write After Read / Anti Dependency): inst2 menulis ke register yang dibaca oleh inst1.
    - WAW (Write After Write / Output Dependency): inst2 menulis ke register yang sama dengan inst1.
    """
    hazards = []
    
    # RAW: inst1.destination dibaca oleh inst2.sources
    if inst1.destination in inst2.sources:
        hazards.append(("RAW", inst1.destination))
        
    # WAR: inst1.sources ditulis oleh inst2.destination
    if inst2.destination in inst1.sources:
        hazards.append(("WAR", inst2.destination))
        
    # WAW: inst1.destination ditulis oleh inst2.destination
    if inst1.destination == inst2.destination:
        hazards.append(("WAW", inst1.destination))
        
    return hazards
