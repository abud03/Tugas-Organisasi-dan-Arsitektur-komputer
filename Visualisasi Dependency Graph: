def analyze_and_draw_graph(instructions):
    # Inisialisasi Directed Graph dengan Graphviz
    dot = graphviz.Digraph(comment='Dependency Graph', format='png')
    dot.attr(rankdir='TB')
    
    # Tambahkan Node untuk setiap instruksi
    for inst in instructions:
        label = f"{inst.name}\n{inst.destination} = {' + '.join(inst.sources)}"
        dot.node(inst.name, label, shape='box', style='filled', color='lightblue')
    
    print("\n" + "=" * 60)
    print("ANALISIS DEPENDENSI (RAW, WAR, WAW)")
    print("=" * 60)
    
    # Analisis pasangan instruksi untuk mencari dependency/hazard
    for i in range(len(instructions)):
        for j in range(i + 1, len(instructions)):
            inst1 = instructions[i]
            inst2 = instructions[j]
            hazards = detect_hazards(inst1, inst2)
            
            for hazard_type, register in hazards:
                print(f"[{hazard_type}] {inst2.name} bergantung pada {inst1.name} (Register: {register})")
                
                # Tentukan warna panah berdasarkan tipe hazard
                color = 'red' if hazard_type == 'RAW' else 'blue' if hazard_type == 'WAR' else 'purple'
                edge_label = f"{hazard_type} ({register})"
                dot.edge(inst1.name, inst2.name, label=edge_label, color=color, fontcolor=color)
                
    return dot

# Jalankan analisis dan visualisasikan graph
dependency_graph = analyze_and_draw_graph(instructions)
display(dependency_graph)
